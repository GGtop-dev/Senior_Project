# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
SUPABASE_URL=https://gbvjhoolyapfrwyhjvra.supabase.co
# publishable key (sb_publishable_...) หรือ anon key ตัวเดียวกับหน้าเว็บ ห้ามใช้ secret / service_role key
SUPABASE_ANON_KEY=sb_publishable_PPhC5yW0R47BJZr0TvFrfg_kNPqclHS
# บัญชีอุปกรณ์ที่สร้างใน Supabase → Authentication → Users
DEVICE_EMAIL=pi-01@devices.local
DEVICE_PASSWORD=change-me

# โมเดล (best.pt หรือโฟลเดอร์ที่ export เป็น NCNN เช่น models/best_ncnn_model)
MODEL_PATH=models/best.pt
MODEL_VERSION=yolov8n-ppe A4
IMGSZ=960
PASS_CONF=0.7
# PASS_CONF_BY_CLASS=mask=0.5,safety_glasses=0.5   (เกณฑ์แยกรายคลาส ไม่ตั้ง = ใช้ PASS_CONF ทุกคลาส)

# สิ่งที่ต้องสวม ใช้ชื่อคลาสแบบตัวเล็กคั่นด้วย _ :
# gloves, helmet, mask, protective_apron, safety_shoes, sleeve, jeans, non_jeans_pants, safety_glasses
REQUIRED_ITEMS=helmet,gloves,safety_shoes,non_jeans_pants,mask,safety_glasses

